@using Yoda.Application.Helpers
@using Yoda.Interfaces
@using Yoda.Application.Models
@using Microsoft.AspNetCore.Hosting;
@using UsersResources;
@using Yoda.Localization;
@using Microsoft.Extensions.Hosting;
@using Humanizer;
@using Yoda.Controllers;
@using YodaApp.Yoda.Application.Notifications;
@using Microsoft.Extensions.DependencyInjection;
@inject INotificationsApiClientFactory notificationsApiClientFactory;
@model Yoda.Application.Models.YodaRenderData
@inject YodaApp.Yoda.Application.Avatars.IAvatarApiClientFactory avatarClient;

@{
    var rootDir = Url.Content("~/") + Model.CurrentLanguage + "/";
    var filesRootDir = Url.Content("~/");
    var dbMode = Model.RequestContext.AppEnv.HostEnvironment;
    var showProductionEnvWarning = Model.ShowProductionEnvironmentWarning;
    string T(LocalizableText text)
    {
        var langTranslator = Model.RequestContext.LangTranslator;
        return langTranslator.Translate(text, Model.CurrentLanguage, "view");
    }
    var notificationsApiClient = await notificationsApiClientFactory.CreateClient();
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <!-- Google tag (gtag.js) -->
    <!-- Google tag HERE -->

    <meta property="og:title" content="Online - Электронный сервис">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://###.kz/Theme/ui-packages/project-theme/logo/tab-icon.png">
    <meta property="og:url" content="https://###.kz">
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="~/Theme/ui-packages/project-theme/logo/tab-icon.svg" />
    <link rel="icon" href="~/Theme/ui-packages/project-theme/logo/tab-icon.png">

    @foreach (var cssFile in Model.StyleSheetFiles)
    {
        using (new ConditionalCommentWrapper(Html, cssFile.ConditionalComment))
        {
            <link type="text/css" rel="stylesheet" href="@cssFile.File?v=@cssFile.Hash" />
        }
    }

    <script type="text/javascript">
        var rootDir = "@rootDir";
    </script>



</head>

<body class="layout-horizontal project-@Model.Project.ToLower() @Model.Module.ToLower()_@Model.Method.ToLower() loading" data-layout="topnav" data-layout-config='{"layoutBoxed":true, "darkMode":false, "showRightSidebarOnStart": true, "leftSideBarTheme":"light"}' data-leftbar-theme='light'>
    @if (dbMode.IsDevelopment())
    {
        <div class="connection-type-label bg-success py-0 px-2 text-white font-12">Тестовая база</div>
    }
    else if (dbMode.IsStaging())
    {
        <div class="connection-type-label bg-success py-0 px-2 text-white font-12">ДЕМО-база</div>
    }
    else if (dbMode.IsProduction())
    {
        if (showProductionEnvWarning)
        {
            <div class="connection-type-label bg-danger py-1 px-2 text-white font-12">Рабочая база</div>
        }
    }
    else
    {
        <div class="connection-type-label bg-success py-0 px-2 text-white font-12">Текущее окружение: @dbMode.EnvironmentName</div>
    }

    @if (Context.Items.ContainsKey("sysHealthMessages"))
    {
        <div class="system-health-messages" style="padding:15px;">
            @foreach (var msg in (HealthDiagnosticMessage[])Context.Items["sysHealthMessages"])
            {
                <p class="system-health-message message-type-@msg.Type.ToString().ToLower()" style="font-size:18px; color:red">
                    @msg.Message
                </p>
            }
        </div>
    }

    <!-- Begin page -->
    <div class="wrapper">


        <!-- Cabinet type indication -->
        @*
        @if (Model.RequestContext.User.IsAuthentificated)
        {
            <div class="container-fluid px-1 px-lg-3 d-none d-sm-block">
                <div class="bg-dark text-light px-2 rounded-5 rounded mt-1 d-block d-md-inline-block font-10 text-center font-weight-bold">@Model.ProjectText</div>
            </div>
        }*@


        <!-- ============================================================== -->
        <!-- Start Page content -->
        <!-- ============================================================== -->

        <div class="content-page">
            <div class="content">

                <!-- MobileTopbar Start -->
                <div class="mobile-topbar-container mb-2">
                    <div class="mobile-topbar">
                        
                        <div class="btn-go-back" id="gobackbtn" type="button" value="go-back" onclick="history.back(1)"><i class="dripicons-chevron-left"></i></div>
                        <script>
                            if (history.length = 0){
                                document.getElementById('gobackbtn').style.display = 'none';
                            };
                        </script>
                        <span class="mobile-topbar-logo logo-template-dark"></span>
                        @{
                            var projectsOverviewUrl = Model.RequestContext.Configuration["projectsOverviewUrl"] ?? Model.RequestContext.YodaActionUrl("CabinetStartPageModule", "CabinetStartPage");
                        }
                        <a class="btn-go-startsite text-dark" id="goqoldaubtn" type="button" href="@( Model.RequestContext.User.IsAuthentificated ? projectsOverviewUrl : "https://template.kz/" )"><i class="dripicons-cross"></i></a>
                       
                    
                    </div>
                    <div class="page-title h5 mx-2 my-3">
                        @ViewData.Model.Title
                    </div>
                </div>
    
                <!-- MobileTopbar END -->

                <!-- Topbar Start -->
                <div class="navbar-custom topnav-navbar">
                    <div class="container-fluid px-2 px-lg-3">
                        <!-- Burger -->
                        <a class="navbar-toggle ml-1 mr-2" data-toggle="collapse" data-target="#topnav-menu-content">
                            <div class="lines">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </a>
                        <!-- LOGO -->
                        <div class="topnav-logo">
                            <span class="topnav-logo-lg">
                                <span class="menu-logo-container">
                                     <span class="topnav-logo-lg-img logo-template-dark"></span>
                                </span>
                            </span>
                         @*   <span class="topnav-logo-sm">
                                <span class="logo-template-dark-sm"></span>
                            </span>*@
                            <!-- LOGOTEXT -->
                           <div class="d-block d-lg-none">
                                <span class="logo-template-dark-text h-100 d-flex align-items-center ml-2"></span>
                            </div>
                        </div>
                        <!-- END LOGO -->
                        <ul class="list-unstyled topbar-right-menu float-right mb-0">

                            <li class="dropdown notification-list topbar-dropdown">
                                <a class="nav-link dropdown-toggle arrow-none bg-transparent" data-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                                    <span class="align-middle d-sm-inline-block">@Model.SupportedLanguages.FirstOrDefault(x => x.Lang == Model.CurrentLanguage)?.Text</span> <i class="uil uil-angle-down d-sm-inline-block align-middle"></i>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right dropdown-menu-animated topbar-dropdown-menu" style="min-width: 4rem;">
                                    @foreach (var language in Model.SupportedLanguages)
                                    {
                                        if (language.Lang.EqualsIgnoreCase(Model.CurrentLanguage))
                                        {
                                            continue;
                                        }
                                        <a href="@LanguagesChangeHelpers.GetChangeLanguageUrl((HtmlHelper)Html, Model.Module, Model.Method, language.Lang)" class="dropdown-item notify-item">
                                            <span class="align-middle">@language.Text</span>
                                        </a>
                                    }
                                </div>
                            </li>


                            @{
                                var user = Model.RequestContext.User;
                                if (user.IsAuthentificated)
                                {
                                    var bin = user.GetUserBin(Model.RequestContext.QueryExecuter);
                                    var fio = user.GetUserShortName(Model.RequestContext.QueryExecuter);
                                    var iin = user.GetUserIin(Model.RequestContext.QueryExecuter);
                                    var userProfileUrl = "#";
                                    if (string.IsNullOrEmpty(Model.RequestContext.Configuration["AuthenticationEndpoint"]))
                                    {
                                        if (user.IsExternalUser())
                                        {
                                            userProfileUrl = Url.YodaAction("ExternalRegistrationModule", "MnuUserProfileRedirect");
                                        }
                                        else
                                        {
                                            userProfileUrl = Url.YodaAction("InternalRegistrationModule", "EditUserInternalSelfData");
                                        }
                                    }
                                    var signOutUrl = Url.YodaAction("UsersCommonFuncModule", "LogOut");

                                    <li class="notification-list">
                                        <a class="nav-link" href="@projectsOverviewUrl" aria-haspopup="false" aria-expanded="false">
                                            <i class="yodic yodic-services noti-icon font-24 text-muted"></i>
                                        </a>
                                    </li>

                                    var notificationsUrl = Model.RequestContext.Configuration["notificationsUrl"];
                                    <li class="notification-list">
                                        <a class="nav-link" href="@notificationsUrl" aria-haspopup="false" aria-expanded="false">
                                            <i class="yodic yodic-notifi noti-icon font-24 text-muted"></i>
                                            @{
                                                var unreadNotificationsCount = await notificationsApiClient.GetUnReadCountAsync(user.Name);
                                                if (unreadNotificationsCount > 0)
                                                {
                                                    <span id="notification-bell-badge" class="notification-bell-badge badge badge-danger">@unreadNotificationsCount</span>
                                                }
                                            }
                                        </a>
                                    </li>
                                    <li class="dropdown notification-list">
                                        <a class="nav-link dropdown-toggle nav-user arrow-none mx-0 bg-transparent" data-toggle="dropdown" href="#" role="button" aria-haspopup="false"
                                       aria-expanded="false">
                                            <span class="account-user-avatar">
                                                <img src="@avatarClient.GetAvatarUrl(iin)" class="rounded-circle avatar-default"></img>
                                            </span>
                                            <span>
                                                <span class="account-user-name">@fio</span>
                                                @{
                                                    if (!string.IsNullOrEmpty(bin))
                                                    {
                                                        <span class="account-position">@bin</span>
                                                    }
                                                }
                                            </span>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right dropdown-menu-animated topbar-dropdown-menu profile-dropdown">
                                            <!-- item-->
                                         
                                            @{
                                                var contextMenuItemsServices = Context.RequestServices.GetRequiredService<IEnumerable<Yoda.IUserContextMenuItems>>();
                                                var contextMenuItemList = contextMenuItemsServices
                                                .SelectMany(x => x.GetUserContextMenuItems(Model.RequestContext));

                                                foreach (var cm in contextMenuItemList)
                                                {
                                                    <a href="@cm.Url" class="dropdown-item notify-item">
                                                        <i class="@cm.IconClassName"></i>
                                                        <span>@cm.Text</span>
                                                    </a>
                                                }
                                            }
                                        </div>
                                    </li>
                                }
                                else
                                {
                                    <li class="dropdown notification-list topbar-dropdown">
                                        <a class="nav-link mr-0" href="@Url.YodaAction("UsersCommonFuncModule", "Challenge")" aria-haspopup="false" aria-expanded="false">
                                            <span class="align-middled-sm-inline-block btn btn-outline-secondary">Войти</span>
                                        </a>
                                    </li>
                                }
                            }

                        </ul>
                       
                    </div>
                </div>
                <!-- end Topbar -->
                <!-- Navbar Start -->
                <div class="topnav">
                    <div class="container-fluid px-1 px-lg-3 active">
                        <nav class="navbar navbar-light navbar-expand-lg topnav-menu">

                            <div class="collapse navbar-collapse active topnav-compact" id="topnav-menu-content">
                                @{
                                    var menuBlockModel = new MenuInfo
                                    {
                                        Menu = Model.Menu,
                                        CurrentModuleName = Model.Module,
                                        CurrentMenuName = Model.Method,
                                        RequestContext = Model.RequestContext,
                                        CurMenuItem = Model.Breadcrumb.MenuItem
                                    };
                                    await Html.RenderPartialAsync("MenuTopBlock", menuBlockModel);
                                }
                            </div>
                        </nav>
                    </div>
                </div>
                <!-- end Navbar -->

                <!-- Mobile Navbar Start -->
                @{
                    await Html.RenderPartialAsync("MenuMobile", Model);
                }
                <!-- Mobile Navbar END -->


                <div class="container-fluid px-2 px-lg-3">

                    <!-- start page title -->
                    <div class="row">
                        <div class="col-12">
                            <div class="page-title-box">
                                <div class="page-title-right">
                                    @{
                                        await Html.RenderPartialAsync("Breadcrumb", Model.Breadcrumb);
                                    }
                                </div>
                                <h4 class="page-title">
                                    @ViewData.Model.Title
                                </h4>

                            </div>
                        </div>
                    </div>
                    <!-- end page title -->
                    <!-- start local-tasks -->
                    @if (!Model.LocalTasksArea.Empty && Model.LocalTasksArea.ExtraElements.Elements.Count() > 0)
                    {
                        <div class="row">
                            <div class="col-12">

                                <div class="local-tasks-box bg-light border border-hr rounded-5 local-tasks-box pt-2 px-2 pb-1 mb-3">

                                    @{
                                        await Html.RenderPartialAsync("LocalTasks", Model.LocalTasksArea);
                                    }

                                </div>
                            </div>
                        </div>
                    }
                    <!-- end local-tasks -->

                    @if (Model.LocalTasksArea.MenuLocalTasks.Length > 0)
                    {
                        await Html.RenderPartialAsync("MenuLocalTasks", Model.LocalTasksArea);
                    }
                    <div class="row">
                        <div class="col-xl-12 col-lg-12">
                            @if (!string.IsNullOrEmpty(TempData["PostbackMessage"] + string.Empty))
                            {
                                <div class="alert alert-info bg-white text-info" role="alert" id="postback-message">@(TempData["PostbackMessage"] + string.Empty)</div>
                            }

                            @{
                                await Html.RenderPartialAsync("MainContent");
                            }
                        </div> <!-- end col -->
                        <!-- PreFooter Start -->
                        <div class="pre-footer col-xl-12 px-4 px-md-2 my-3">
                            <div class="row">
                                <div class="col-sm-8 text-left">
                                    <span class="footer-logo-lg-img logo-template-dark"></span>
                                    <h5 class="text-uppercase text-dark my-3">
                                        IS NOT A VERY LONG<br />PROJECT NAME
                                    </h5>
                                    <a class="text-secondary" href="#" target="_blank">@T("Пользовательcкое соглашение")</a><br />
                                    <a class="text-secondary" href="#" target="_blank">@T("Политика конфиденциальности")</a>
                                    <div class="my-2">
                                        <a href="" class="mobile-store-logo mobile-store-playmarket mr-1"></a><a href="" class="mobile-store-logo mobile-store-appstore"></a>
                                    </div>

                                </div>

                                <div class="col-sm-4">
                                    <div class="card mb-0 qr-footer-card text-center float-right">
                                        <div class="card-body p-1">
                                            <div class="qr-project-footer qr-project-img-template"></div>
                                            <span class="">@T("Telegram группа")</span>
                                            <a target="_blank" href="#" class="font-weight-bold mt-0 d-block pb-2"><i class="uil uil-at"></i>DemoTemplate</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- container -->

            </div>
            <!-- End content -->
            <!-- Footer Start -->
            <footer class="footer">
                <div class="container-fluid">

                    <hr />
                    <div class="row">
                    
                        <div class="col-md-6 text-left text-uppercase">
                            <script>document.write(new Date().getFullYear())</script> © 
                            <script>
                                var hostSplit = location.host.split("."); 
                                document.write(([hostSplit[hostSplit.length - 2], hostSplit[hostSplit.length - 1]].join('.')).toUpperCase())
                            </script>
                        </div>
                        <div class="col-md-6">
                            <!--
                                <div class="text-md-right footer-links d-none d-md-block">
                                <a target="_blank" href="#">Контакты</a>
                                 -->
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
            <!-- end Footer -->
            <div id="perf" class="d-none">@Model.Stopwatch.ElapsedMilliseconds</div>
        </div>

        <!-- ============================================================== -->
        <!-- End Page content -->
        <!-- ============================================================== -->


    </div>
    <!-- END wrapper -->
    @foreach (var jsFile in Model.JsFiles)
    {
        using (new ConditionalCommentWrapper(Html, jsFile.ConditionalComment))
        {
            <script src="@jsFile.File?v=@jsFile.Hash" type="text/javascript"></script>
        }
    }
</body>
</html>
