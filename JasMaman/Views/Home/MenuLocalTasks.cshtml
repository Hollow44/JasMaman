@using Yoda.Application.Helpers
@using Yoda.Interfaces
@model Yoda.Application.Models.LocalTaskAreaElements
@if (Model == null || Model.MenuLocalTasks.Length == 0) {
    return;
}

@{ 
    foreach(var localTasks in Model.MenuLocalTasks) {
        var enabledLocalTasks = new List<LocalTaskMenuItem>();
        foreach(var localTask in localTasks) {
            if(await localTask.MenuItem.NativeMenuLink.EnabledFunc(Model.RequestContext)) {
	            enabledLocalTasks.Add(localTask);
            }
        }
if(enabledLocalTasks.Count == 0) {
	return;
}

        <ul class="nav-local-tasks nav nav-pills bg-white mb-3 mt-2">
        @foreach (var task in enabledLocalTasks) {
            var menu = task.MenuItem.NativeMenuLink;
            var activeClass = task.IsActive ? "active" : string.Empty;
            var url = Html.YodaAction(task.MenuItem.ModuleName, menu.Name, menu.RawQueryDefaultParams);
            var badge = menu.MenuBadge?.Invoke(Model.RequestContext);
            <li class="nav-item">
                <a href="@url" aria-expanded="false" class="nav-link @activeClass">
                    @*<i class="mdi mdi-home-variant d-md-none"></i>*@
                    
                    <span class="d-md-block">
                        @menu.GetLinkText(Model.RequestContext) 
                        @if (badge != null) {
                            <span class="badge badge-@badge.ContextualColor.ToString().ToLower() ml-1" style="position:relative;bottom:1px;">@badge.Text</span>
                        }
                    </span>
                </a>
            </li>
        }
    </ul>
    }
}