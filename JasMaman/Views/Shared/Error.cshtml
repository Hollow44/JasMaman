@using YodaCorePlugin.Controllers.Modules;
@model ExceptionInfoModel;

@{

}

<div class="card">
    <div class="card-body">
       
        @if (Model.HasDetails) {
            <div class="fw-800 h3 mb-3 rounded-5 px-3 py-1 bg-dark text-white d-inline-block">ERROR<span class="pl-1">№@Model.Id</span></div>
            <div class="h3 lh-sm">
                Во время выполнения произошла ошибка 
            </div>
            <span class="text-secondary font-16 mt-5">Сведения зарегистрированы в системе для выяснения причин</span>
            <div class="mt-3 font-16 lh-1 font-weight-bold mb-2">Вернитесь на предыдущую страницу<br />и повторите попытку позже</div>
            <a class="btn btn-primary px-5 mb-2" href="javascript:history.go(-1)">Вернуться</a>

            @if (Model.ShowDetails) {
                <hr />
                <div class="h5">Пользователь</div>
                <div class="">
                    @(Model.Date is null ? string.Empty : Model.Date.Value.ToString("dd.MM.yyyy HH:mm"))
                </div>
                <div class="">
                    @(Model.User is null ? string.Empty : Model.User)
                </div>
                <div class="">
                    @(Model.Url is null ? string.Empty : Model.Url)
                </div>
                <hr />
                <div class="h5">Исключение</div>
                <div class="font-12">
                    @Model.ExceptionMessage
                </div>
            }
        } else {
            <div class="fw-800 h3 mb-3 rounded-5 px-3 py-1 bg-dark text-white d-inline-block">ERROR</div>
            <div class="h3 lh-1">
                Во время выполнения произошла ошибка
            </div>
            <span class="text-secondary font-16 mt-5">Сведения зарегистрированы в системе для выяснения причин</span>
            <div class="mt-3 font-16 lh-1 font-weight-bold mb-2">Повторите попытку через некоторое время,<br />вернувшись на предыдущую страницу</div>
            <a class="btn btn-primary px-5 mb-2" href="javascript:history.go(-1)">Вернуться</a>
        }

    </div>
</div>